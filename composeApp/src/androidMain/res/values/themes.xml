<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <!-- windowBackground backs the app's content window in general — without it this
             defaults to plain system white. windowSplashScreenBackground is the Android 12+
             (API 31+) splash screen background shown before Compose's first frame renders;
             set to the brand teal (matching the launcher icon's own background) rather than
             the paper content background, so the launch screen reads as a deliberate brand
             moment rather than a blank content frame. -->
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowSplashScreenBackground">@color/signal</item>
    </style>
</resources>
